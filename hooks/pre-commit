#!/usr/bin/env bash
# =============================================================================
# hooks/pre-commit — Git pre-commit hook
# Fast security check before committing. Focuses on:
#   1. Secret detection (Gitleaks) — BLOCKING
#   2. Quick SAST on staged files (Semgrep) — configurable
#
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or use:  ./hooks/install-hooks.sh
#
# Skip (emergency): git commit --no-verify  (logged in commit message metadata)
# =============================================================================

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; RESET='\033[0m'; BOLD='\033[1m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
HOOK_DIR="$(dirname "$0")"
SCRIPT_DIR="$REPO_ROOT/.gitlab/security-scripts"
# Fallback for local dev without .gitlab dir
[[ ! -d "$SCRIPT_DIR" ]] && SCRIPT_DIR="$REPO_ROOT/scripts"

REPORT_DIR="$REPO_ROOT/.security-reports-precommit"
mkdir -p "$REPORT_DIR"

echo -e "\n${BOLD}[pre-commit] Security check...${RESET}"

# ── Get staged files ──────────────────────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  echo -e "${GREEN}[pre-commit] No staged files — skipping${RESET}\n"
  exit 0
fi

STAGED_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
echo "[pre-commit] Scanning $STAGED_COUNT staged file(s)..."

# ── 1. Secret Detection ───────────────────────────────────────────────────────
SECRET_EXIT=0

if command -v gitleaks &>/dev/null; then
  # Scan only staged content (not working tree)
  gitleaks protect \
    --staged \
    --source="$REPO_ROOT" \
    --report-format=json \
    --report-path="$REPORT_DIR/pre-commit-secrets.json" \
    --redact \
    --quiet \
    2>/dev/null || SECRET_EXIT=$?

  if [[ $SECRET_EXIT -ne 0 ]]; then
    echo -e "\n${RED}${BOLD}╔══════════════════════════════════════════╗${RESET}"
    echo -e "${RED}${BOLD}║  🚨 SECRETS DETECTED — COMMIT BLOCKED   ║${RESET}"
    echo -e "${RED}${BOLD}╚══════════════════════════════════════════╝${RESET}"
    echo ""

    # Show findings (redacted)
    python3 -c "
import json, os
report = '$REPORT_DIR/pre-commit-secrets.json'
if os.path.exists(report):
    data = json.load(open(report))
    findings = data if isinstance(data, list) else data.get('findings', [])
    for f in findings[:5]:  # Show first 5
        print(f'  ⚠️  {f.get(\"RuleID\",\"unknown\")} in {f.get(\"File\",\"unknown\")}:{f.get(\"StartLine\",\"?\")}')
    if len(findings) > 5:
        print(f'  ... and {len(findings)-5} more')
" 2>/dev/null || true

    echo ""
    echo -e "${YELLOW}To fix:${RESET}"
    echo "  1. Remove the secret from the file"
    echo "  2. Add to .gitignore if it's a config file"
    echo "  3. If test/example value: add '# gitleaks:allow' comment"
    echo "  4. Rotate the secret if it was ever committed"
    echo ""
    echo -e "${RED}Report: $REPORT_DIR/pre-commit-secrets.json${RESET}"
    echo ""
    exit 1
  fi
  echo -e "${GREEN}[pre-commit] ✓ No secrets detected${RESET}"
else
  echo -e "${YELLOW}[pre-commit] WARNING: gitleaks not installed — skipping secret scan${RESET}"
  echo "[pre-commit] Install: brew install gitleaks"
fi

# ── 2. Quick SAST on staged TypeScript/JS files ───────────────────────────────
SAST_EXIT=0

# Only run if Semgrep installed AND there are TS/JS staged files
TS_STAGED=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [[ -n "$TS_STAGED" ]] && command -v semgrep &>/dev/null; then
  echo "[pre-commit] Running quick SAST on staged TS/JS files..."

  # Write staged files to temp for scanning
  TEMP_DIR=$(mktemp -d)
  trap 'rm -rf "$TEMP_DIR"' EXIT

  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    mkdir -p "$TEMP_DIR/$(dirname "$file")"
    git show ":$file" > "$TEMP_DIR/$file" 2>/dev/null || true
  done <<< "$TS_STAGED"

  SEMGREP_CONFIG="$REPO_ROOT/templates/semgrep.yml"
  SEMGREP_ARGS=("p/typescript" "p/secrets")
  [[ -f "$SEMGREP_CONFIG" ]] && SEMGREP_ARGS+=("$SEMGREP_CONFIG")

  SEMGREP_CRITICAL=0
  for config in "${SEMGREP_ARGS[@]}"; do
    semgrep \
      --config "$config" \
      --json \
      --json-output="$REPORT_DIR/pre-commit-sast-partial.json" \
      --metrics=off \
      --quiet \
      "$TEMP_DIR" 2>/dev/null || SAST_EXIT=$?
  done

  if [[ $SAST_EXIT -ne 0 ]]; then
    # Count critical/error findings
    CRITICAL_COUNT=$(python3 -c "
import json, os
f = '$REPORT_DIR/pre-commit-sast-partial.json'
if not os.path.exists(f): 
    print(0)
    exit()
d = json.load(open(f))
errors = [r for r in d.get('results',[]) if r.get('extra',{}).get('severity','').upper() in ['ERROR','CRITICAL']]
print(len(errors))
" 2>/dev/null || echo "0")

    if [[ "$CRITICAL_COUNT" -gt 0 ]]; then
      echo -e "\n${RED}[pre-commit] ✗ $CRITICAL_COUNT critical SAST finding(s) detected${RESET}"
      echo -e "${YELLOW}  Review: $REPORT_DIR/pre-commit-sast-partial.json${RESET}"
      echo -e "${YELLOW}  Run full scan: ./scripts/scan-all.sh --mode local${RESET}\n"
      exit 1
    else
      echo -e "${YELLOW}[pre-commit] ⚠ SAST warnings found (non-blocking) — review before merge${RESET}"
    fi
  else
    echo -e "${GREEN}[pre-commit] ✓ SAST clean${RESET}"
  fi
fi

# ── Done ──────────────────────────────────────────────────────────────────────
echo -e "${GREEN}[pre-commit] ✓ Security check passed${RESET}\n"
exit 0
